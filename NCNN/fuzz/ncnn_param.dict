# --- binary magic: int32 7767517 LE (0x7685DD) ---
bin_magic="\xDD\x85\x76\x00"

# --- binary int32 boundaries (LE) ---
bin_zero="\x00\x00\x00\x00"
bin_one="\x01\x00\x00\x00"
bin_negone="\xFF\xFF\xFF\xFF"
bin_intmin="\x00\x00\x00\x80"
bin_intmax="\xFF\xFF\xFF\x7F"

# --- binary float tokens (LE) ---
bin_f1="\x00\x00\x80\x3F"
bin_f0="\x00\x00\x00\x00"
bin_fneg0="\x00\x00\x00\x80"
bin_fmax="\xFF\xFF\xFF\x7F"
